load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-bazel-compat",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_bazel_compat",
    edition = "2024",
    version = "0.0.1",
    deps = ["@crates//:anyhow", "@crates//:clap", "@crates//:serde_json", "@crates//:serde", "@crates//:thiserror", ],
)

rust_test(
    name = "fjfj-bazel-compat_test",
    crate = ":fjfj-bazel-compat",
)
