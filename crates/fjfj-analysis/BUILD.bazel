load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-analysis",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_analysis",
    edition = "2024",
    version = "0.0.1",
    deps = ["@crates//:thiserror", "@crates//:tokio", "@crates//:tracing", "//crates/fjfj-engine", "//crates/fjfj-graph", "//crates/fjfj-loading", "//crates/fjfj-starlark", ],
)

rust_test(
    name = "fjfj-analysis_test",
    crate = ":fjfj-analysis",
    deps = ["@crates//:tempfile", "//crates/fjfj-bzlmod", "//crates/fjfj-repo", ],
)
