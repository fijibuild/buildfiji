load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-loading",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_loading",
    edition = "2024",
    version = "0.0.1",
    deps = [
        "//crates/fjfj-graph",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "fjfj-loading_test",
    crate = ":fjfj-loading",
    deps = ["@crates//:tempfile"],
)
