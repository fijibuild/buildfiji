load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-exec",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_exec",
    edition = "2024",
    version = "0.0.1",
    deps = ["@crates//:anyhow", "@crates//:futures", "@crates//:hex", "@crates//:libc", "@crates//:serde", "@crates//:serde_json", "@crates//:sha2", "@crates//:thiserror", "@crates//:time", "@crates//:tokio", "@crates//:tracing", "//crates/fjfj-bazel-compat", "//crates/fjfj-graph", "//crates/fjfj-remote", "//crates/fjfj-sandbox", ],
)

rust_test(
    name = "fjfj-exec_test",
    crate = ":fjfj-exec",
    deps = ["@crates//:tempfile", "@crates//:tracing-subscriber", "//crates/fjfj-telemetry"],
)
