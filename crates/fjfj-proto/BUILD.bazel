load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

package(default_visibility = ["//visibility:public"])

# rust_prost_library names its generated crate after this proto_library
# target, so it's named to match the Cargo crate ("fjfj_proto") rather than
# "command_proto"; callers write `fjfj_proto::fjfj::v1::...` under Bazel vs.
# the flat `fjfj_proto::...` build.rs produces under Cargo (tonic-prost's
# generated module nests by proto package, the include! in src/lib.rs does
# not) — a known seam between the two codegen paths, not a bug.
proto_library(
    name = "fjfj_proto",
    srcs = ["proto/fjfj/v1/command.proto"],
    strip_import_prefix = "proto",
)

# Generated prost/tonic bindings for fjfj_proto, from the same .proto
# sources Cargo compiles via build.rs + tonic-prost-build. The two
# toolchains pin different prost/tonic runtime versions (rules_rust_prost
# vendors its own); that's fine as long as nothing in one build graph mixes
# generated types from both.
rust_prost_library(
    name = "fjfj-proto",
    proto = ":fjfj_proto",
)

rust_test(
    name = "fjfj-proto_test",
    srcs = ["tests/bazel_smoke.rs"],
    edition = "2024",
    deps = [":fjfj-proto"],
)
