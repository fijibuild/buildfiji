load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

package(default_visibility = ["//visibility:public"])

# rust_prost_library names its generated crate after this proto_library
# target, so it's named to match the Cargo crate ("fjfj_proto") rather than
# "command_proto".
proto_library(
    name = "fjfj_proto",
    srcs = ["proto/fjfj/v1/command.proto"],
    strip_import_prefix = "proto",
)

# Generated prost/tonic bindings for fjfj_proto, from the same .proto
# sources Cargo compiles via build.rs + tonic-prost-build. src/lib.rs nests
# its include! under the same `fjfj::v1` module rust_prost_library uses
# (buildfiji-23d.23), so both build graphs expose
# `fjfj_proto::fjfj::v1::...` — tests/smoke.rs runs unmodified under both.
# The two toolchains still pin different prost/tonic runtime versions
# (rules_rust_prost vendors its own); that's fine as long as nothing in one
# build graph mixes generated types from both.
rust_prost_library(
    name = "fjfj-proto",
    proto = ":fjfj_proto",
)

rust_test(
    name = "fjfj-proto_test",
    srcs = ["tests/smoke.rs"],
    edition = "2024",
    deps = [":fjfj-proto"],
)
