load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-graph",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_graph",
    edition = "2024",
    version = "0.0.1",
    deps = ["@crates//:anyhow", "@crates//:hex", "@crates//:serde", "@crates//:sha2", "@crates//:thiserror", "@crates//:tracing", ],
)

rust_test(
    name = "fjfj-graph_test",
    crate = ":fjfj-graph",
)
