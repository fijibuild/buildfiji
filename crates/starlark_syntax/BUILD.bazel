load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Vendored from starlark-rust 0.14.2 with fjfj's patches applied (see
# docs/design/starlark-and-loading.md); third-party style, so the lint aspects skip it.
rust_library(
    name = "starlark_syntax",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/**", "testcases/**"], exclude = ["src/**/*.rs"], allow_empty = True),
    crate_name = "starlark_syntax",
    edition = "2024",
    version = "0.14.2",
    tags = ["no-clippy", "no-rustfmt"],
    deps = [
        "@crates//:allocative",
        "@crates//:annotate-snippets",
        "@crates//:anyhow",
        "@crates//:derive_more",
        "@crates//:dupe",
        "@crates//:logos",
        "@crates//:lsp-types",
        "@crates//:memchr",
        "@crates//:num-bigint",
        "@crates//:num-traits",
        "@crates//:once_cell",
        "@crates//:pagable",
        "@crates//:starlark_map",
        "@crates//:thiserror",
    ],
    proc_macro_deps = [
        "@crates//:derivative",
    ],
)
