load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-repo",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["embedded_tools.tar.zst"],
    crate_name = "fjfj_repo",
    edition = "2024",
    version = "0.0.1",
    deps = [
        "@crates//:base64",
        "@crates//:hex",
        "@crates//:sha2",
        "//crates/fjfj-archive",
        "//crates/fjfj-bzlmod",
        "//crates/fjfj-graph",
        "//crates/fjfj-loading",
        "//crates/fjfj-starlark",
        "@crates//:reqwest",
        "@crates//:serde_json",
        "//crates/starlark",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "fjfj-repo_test",
    crate = ":fjfj-repo",
    deps = [
        "@crates//:regex",
        "@crates//:tempfile",
    ],
)
