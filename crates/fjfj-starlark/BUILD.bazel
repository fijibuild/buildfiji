load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-starlark",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["testdata/**", "src/**/*.bzl"]),
    crate_name = "fjfj_starlark",
    edition = "2024",
    version = "0.0.1",
    deps = [
        "//crates/fjfj-archive",
        "//crates/fjfj-graph",
        "//crates/fjfj-loading",
        "@crates//:allocative",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:hex",
        "@crates//:sha2",
        "@crates//:num-bigint",
        "@crates//:stacker",
        "@crates//:starlark",
        "@crates//:starlark_syntax",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
    proc_macro_deps = ["@crates//:starlark_derive"],
)

rust_test(
    name = "fjfj-starlark_test",
    crate = ":fjfj-starlark",
    deps = [
        "@crates//:regex",
        "@crates//:tempfile",
    ],
)
