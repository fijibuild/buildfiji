load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-starlark",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_starlark",
    edition = "2024",
    version = "0.0.1",
    deps = ["@crates//:anyhow", "@crates//:starlark_syntax", "@crates//:starlark", "@crates//:thiserror", "@crates//:tracing", ],
)

rust_test(
    name = "fjfj-starlark_test",
    crate = ":fjfj-starlark",
)
