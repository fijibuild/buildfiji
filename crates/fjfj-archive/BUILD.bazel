load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fjfj-archive",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fjfj_archive",
    edition = "2024",
    version = "0.0.1",
    deps = [
        "@crates//:ar",
        "@crates//:bzip2",
        "@crates//:flate2",
        "@crates//:tar",
        "@crates//:thiserror",
        "@crates//:xz2",
        "@crates//:zip",
        "@crates//:zstd",
    ],
)

rust_test(
    name = "fjfj-archive_test",
    crate = ":fjfj-archive",
    deps = ["@crates//:tempfile"],
)
