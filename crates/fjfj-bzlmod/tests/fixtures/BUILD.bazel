load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Fixtures for the bzlmod conformance tests: one local module registry and
# a workspace per resolution scenario, each with the module graph real
# Bazel resolves for it (see refresh_golden.sh).

filegroup(
    name = "fixtures",
    srcs = glob([
        "registry/**",
        "workspaces/**",
        "lockfiles/**",
        "bcr/**",
    ]) + [
        # `workspaces/include` is a package of its own.
        "//crates/fjfj-bzlmod/tests/fixtures/registry/modules/ext/1.0:files",
        "//crates/fjfj-bzlmod/tests/fixtures/registry/modules/ext/2.0:files",
        "//crates/fjfj-bzlmod/tests/fixtures/workspaces/extensions:files",
        "//crates/fjfj-bzlmod/tests/fixtures/workspaces/extensions_versions:files",
        "//crates/fjfj-bzlmod/tests/fixtures/workspaces/include:files",
    ],
    # buildfiji-gwl.17: fjfj-cli's own bzlmod-flag test reuses the registry
    # fixture rather than duplicating it.
    visibility = [
        "//crates/fjfj-bzlmod:__pkg__",
        "//crates/fjfj-cli:__pkg__",
    ],
)

py_binary(
    name = "graph_to_golden",
    srcs = ["graph_to_golden.py"],
)

py_binary(
    name = "dump_mappings",
    srcs = ["dump_mappings.py"],
)

py_binary(
    name = "lock_hashes",
    srcs = ["lock_hashes.py"],
    # What the script checks the Bazel Central Registry's hashes against.
    data = ["lockfiles/9.2.0.lock"],
)

sh_binary(
    name = "refresh_golden",
    srcs = ["refresh_golden.sh"],
    data = [
        ":dump_mappings",
        ":graph_to_golden",
        ":lock_hashes",
        "@bazel_tools//tools/bash/runfiles",
    ],
)
