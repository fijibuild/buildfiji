load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

# Spike for buildfiji-mum.1: measures the starlark crate's lex/parse/eval
# throughput and AST memory on real BUILD trees (fixtures/fetch.sh gets the
# corpora). Not part of fjfj proper.
rust_binary(
    name = "fjfj-spike-starlark-parse",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    version = "0.0.1",
    deps = [
        "//crates/fjfj-starlark",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:starlark",
        "@crates//:starlark_syntax",
    ],
)
